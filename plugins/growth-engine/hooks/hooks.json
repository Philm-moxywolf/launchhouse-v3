{
  "description": "Launchhouse: folder context at the start of a session, the rules on every file written into growth-engine, a hard stop on the vendor tools that send, activate or buy, and a fresh yes before anything that spends, publishes or enrols.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/context.sh\""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/context.sh\" --compact"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-pre.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*(conversations_send-a-new-message|apollo_emailer_messages_send_now|apollo_emailer_messages_create|apollo_emailer_campaigns_approve|apollo_sequences_create|apollo_sequences_update|apollo_email_account_purchase_create)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/deny-mcp.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*(apollo_people_match|apollo_people_bulk_match|apollo_organizations_enrich|apollo_organizations_bulk_enrich|apollo_emailer_campaigns_add_contact_ids|apollo_contacts_create|apollo_contacts_bulk_create|social-media-posting_create-post|social-media-posting_edit-post|emails_create-template)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/ask-mcp.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-post.sh\""
          }
        ]
      }
    ]
  }
}
